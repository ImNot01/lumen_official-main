import { useState } from 'react'
import { supabase } from '../lib/supabase'
import { useAuth } from '../context/AuthContext'
import { Alert, Logo, Spinner, Splash, ThemeToggle } from '../components/ui'

export default function Home() {
  const { profile, session, signOut } = useAuth()
  const [confirmText, setConfirmText] = useState('')
  const [showDelete, setShowDelete] = useState(false)
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState<string | null>(null)

  if (!profile) return <Splash />

  async function deleteAccount() {
    setError(null)
    setBusy(true)
    try {
      const { error: err } = await supabase.rpc('delete_my_account')
      if (err) {
        setError(err.message)
        return
      }
      await signOut()
    } catch (ex) {
      setError(ex instanceof Error ? ex.message : 'Could not delete the account.')
    } finally {
      setBusy(false)
    }
  }

  const since = new Date(profile.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })

  return (
    <div className="mx-auto flex min-h-[100dvh] max-w-xl flex-col px-4 py-6">
      <header className="flex items-center justify-between">
        <div className="flex items-center gap-3">
          <Logo size={36} />
          <span className="text-lg font-semibold tracking-tight">Lumen</span>
        </div>
        <ThemeToggle />
      </header>

      <main className="mt-8 space-y-5">
        <section className="glass p-6">
          <div className="flex items-center gap-4">
            <div
              className="flex h-16 w-16 items-center justify-center rounded-full bg-brand-700 text-2xl font-semibold text-white dark:bg-brand-500 dark:text-slate-950"
              aria-hidden="true"
            >
              {profile.display_name.charAt(0).toUpperCase()}
            </div>
            <div className="min-w-0">
              <p className="truncate text-xl font-semibold">{profile.display_name}</p>
              <p className="truncate text-slate-500 dark:text-slate-400">@{profile.username}</p>
            </div>
          </div>
          <dl className="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
            <div>
              <dt className="text-slate-500 dark:text-slate-400">Email</dt>
              <dd className="truncate font-medium">{session?.user.email}</dd>
            </div>
            <div>
              <dt className="text-slate-500 dark:text-slate-400">Member since</dt>
              <dd className="font-medium">{since}</dd>
            </div>
          </dl>
        </section>

        <section className="glass p-6">
          <h2 className="text-base font-semibold">Foundation is live</h2>
          <p className="mt-1.5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
            Your account, database and security rules are working. Conversations arrive in the next phase.
          </p>
        </section>

        <section className="glass space-y-3 p-6">
          <button type="button" className="btn-ghost w-full" onClick={() => void signOut()}>
            Sign out
          </button>
          {!showDelete ? (
            <button type="button" className="w-full py-2 text-sm font-medium text-red-600 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 dark:text-red-400" onClick={() => setShowDelete(true)}>
              Delete my account
            </button>
          ) : (
            <div className="space-y-3 rounded-2xl border border-red-200 p-4 dark:border-red-500/30">
              <p className="text-sm">
                This permanently deletes your account and profile. Type <strong>{profile.username}</strong> to confirm.
              </p>
              {error && <Alert kind="error">{error}</Alert>}
              <input className="input" value={confirmText} onChange={(e) => setConfirmText(e.target.value)} aria-label="Type your username to confirm" autoCapitalize="none" />
              <div className="flex gap-2">
                <button type="button" className="btn-ghost flex-1" onClick={() => { setShowDelete(false); setConfirmText(''); setError(null) }}>
                  Cancel
                </button>
                <button type="button" className="btn-danger flex-1" disabled={busy || confirmText !== profile.username} onClick={() => void deleteAccount()}>
                  {busy && <Spinner className="h-4 w-4" />} Delete forever
                </button>
              </div>
            </div>
          )}
        </section>
      </main>
    </div>
  )
}
